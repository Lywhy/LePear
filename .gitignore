# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.npm/
.yarn/cache/

# Build output and incremental compiler data
/dist/
/dist-ssr/
*.tsbuildinfo
.vite/
.cache/

# Local environment files; keep portable examples
.env
.env.*
!.env.example
!.env.*.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Generated reports and temporary workspace artifacts
/coverage/
/playwright-report/
/test-results/
/work/
/tmp/
/temp/
*.tmp
*.bak

# Local agent/MCP configuration (machine-specific paths)
/.codex/

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Keep source, assets, documentation, examples, AGENTS.md and pnpm-lock.yaml tracked.

# Local YouTube runtime and generated media
/.tools/
/.youtube-cache/
/.youtube-downloads/

# Accidental local downloads and interrupted downloader files.
# Source media assets elsewhere remain eligible for version control.
/downloads/
/media-downloads/
*.part
*.ytdl
