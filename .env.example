# Local Node API. Copy to .env and restart both API and Vite after changes.
YOUTUBE_API_PORT=8787
YOUTUBE_METADATA_TIMEOUT_MS=45000
YOUTUBE_MAX_DURATION_SECONDS=7200
YOUTUBE_METADATA_CONCURRENCY=2
YOUTUBE_METADATA_RATE_LIMIT=10
YOUTUBE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
# Optional absolute path or path relative to the repository.
# YOUTUBE_YTDLP_PATH=C:/tools/yt-dlp.exe

# Shared jobs: video, audio and subtitles. API binds to 127.0.0.1.
YOUTUBE_JOB_TIMEOUT_MS=600000
YOUTUBE_JOB_TTL_MS=900000
YOUTUBE_JOB_CONCURRENCY=1
YOUTUBE_MAX_FILE_BYTES=1073741824
YOUTUBE_MAX_STORAGE_BYTES=4294967296
# Optional absolute paths or paths relative to the repository.
# YOUTUBE_FFMPEG_PATH=C:/tools/ffmpeg.exe
# YOUTUBE_FFPROBE_PATH=C:/tools/ffprobe.exe

# Local pause after YouTube subtitle HTTP 429. Does not guarantee YouTube unblocks after this time.
YOUTUBE_SUBTITLE_COOLDOWN_MS=300000

# File converter: same local API port and origin allowlist as YouTube, independent jobs/store.
CONVERTER_MAX_INPUT_BYTES=104857600
CONVERTER_MAX_OUTPUT_BYTES=536870912
CONVERTER_MAX_DURATION_SECONDS=1800
CONVERTER_JOB_TIMEOUT_MS=300000
CONVERTER_UPLOAD_TIMEOUT_MS=120000
CONVERTER_FILE_TTL_MS=900000
CONVERTER_CONCURRENCY=1
CONVERTER_MAX_STORAGE_BYTES=1073741824
# Defaults to the shared FFmpeg/ffprobe installed by youtube:setup-ffmpeg.
# CONVERTER_FFMPEG_PATH=C:/tools/ffmpeg.exe
# CONVERTER_FFPROBE_PATH=C:/tools/ffprobe.exe
CONVERTER_MAX_IMAGE_PIXELS=25000000
